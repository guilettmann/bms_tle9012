Debug/
Release/
*.o
*.d
*.elf
*.bin
*.hex
*.list
*.map
*.su
*.cyclo

# ---------------------------------------------------------------------------
# Eclipse / CubeIDE — estado local do workspace
# ---------------------------------------------------------------------------
.settings/
.metadata/
RemoteSystemsTempFiles/
*.launch
*.bak

# ---------------------------------------------------------------------------
# Documentacao de fornecedor
# ---------------------------------------------------------------------------
# Manuais, datasheets e esquematicos de fabricante nao vao para o
# repositorio: sao material com copyright de terceiros (alguns marcados
# como confidenciais). O relatorio cita cada um pelo nome e revisao;
# baixar do site de cada fabricante e colocar em docs/.
# Unico PDF versionado: o proprio relatorio.
docs/*.pdf
!docs/relatorio_estrutura_software_bms.pdf

# ---------------------------------------------------------------------------
# Sistema operacional
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Rastreados de proposito (nao remover das excecoes):
#   .project, .cproject  -> sem eles o CubeIDE nao abre o projeto
#   *.ioc, .mxproject    -> configuracao do CubeMX
#   *.ld                 -> linker scripts, alterados na fase 4
#   Drivers/             -> HAL/CMSIS gerados; necessarios para compilar
# ---------------------------------------------------------------------------
