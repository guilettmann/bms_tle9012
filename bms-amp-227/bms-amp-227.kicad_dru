    (condition "A.NetName == 'T06' && (B.NetName == 'T14' || B.NetName == 'T15' || B.NetName == 'T16' || B.NetName == 'T17' || B.NetName == 'T18' || B.NetName == 'T19' || B.NetName == 'T20' || B.NetName == 'T21' || B.NetName == 'T22' || B.NetName == 'T23' || B.NetName == 'T24' || B.NetName == 'T25' || B.NetName == 'T26' || B.NetName == 'T27' || B.NetName == 'T28' || (B.NetName == '*_2' && B.NetName != 'Net*') || (B.NetName == '*_3' && B.NetName != 'Net*'))"))

(rule "isolamento T07 > 30 V"
