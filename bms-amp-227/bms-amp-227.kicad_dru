    (layer outer)
    (constraint clearance (min 0.6mm))
    (condition "A.NetName == 'T24' && ((B.NetName == '*_0' && B.NetName != 'Net*') || (B.NetName == '*_1' && B.NetName != 'Net*'))"))

(rule "isolamento T25 > 30 V"
    (layer outer)
    (constraint clearance (min 0.6mm))
