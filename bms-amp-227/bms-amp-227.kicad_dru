(version 1)

# Regras da slave do BMS AMP 227 (4 x TLE9012, 28S). Geradas por gen_dru.py.
# Isolamento por diferenca de tensao: tomadas Ti e Tj ficam a |i - j| x 4,2 V.
# Ate 30 V vale o padrao (0,2 mm); acima de 30 V, 0,6 mm (IPC-2221B, Tab. 6-1, B2,
# 31 a 100 V, externo sem verniz; valor de memoria, conferir na norma). Camadas internas:
# B1 (interno) pede 0,1 mm nessa faixa, entao o padrao de 0,2 mm basta.
# Nets locais de cada CSC (sufixo _k) ficam entre T(7k) e T(7k+7).

(rule "fanout TLE9012"
    (constraint clearance (min 0.2mm))
    (condition "A.memberOfFootprint('U?') && (B.memberOfFootprint('U?') || B.intersectsCourtyard('U?'))"))

(rule "isolamento T00 > 30 V"
    (layer outer)
    (constraint clearance (min 0.6mm))
    (condition "A.NetName == 'T00' && (B.NetName == 'T08' || B.NetName == 'T09' || B.NetName == 'T10' || B.NetName == 'T11' || B.NetName == 'T12' || B.NetName == 'T13' || B.NetName == 'T14' || B.NetName == 'T15' || B.NetName == 'T16' || B.NetName == 'T17' || B.NetName == 'T18' || B.NetName == 'T19' || B.NetName == 'T20' || B.NetName == 'T21' || B.NetName == 'T22' || B.NetName == 'T23' || B.NetName == 'T24' || B.NetName == 'T25' || B.NetName == 'T26' || B.NetName == 'T27' || B.NetName == 'T28' || (B.NetName == '*_2' && B.NetName != 'Net*') || (B.NetName == '*_3' && B.NetName != 'Net*'))"))

(rule "isolamento T01 > 30 V"
    (layer outer)
    (constraint clearance (min 0.6mm))
    (condition "A.NetName == 'T01' && (B.NetName == 'T09' || B.NetName == 'T10' || B.NetName == 'T11' || B.NetName == 'T12' || B.NetName == 'T13' || B.NetName == 'T14' || B.NetName == 'T15' || B.NetName == 'T16' || B.NetName == 'T17' || B.NetName == 'T18' || B.NetName == 'T19' || B.NetName == 'T20' || B.NetName == 'T21' || B.NetName == 'T22' || B.NetName == 'T23' || B.NetName == 'T24' || B.NetName == 'T25' || B.NetName == 'T26' || B.NetName == 'T27' || B.NetName == 'T28' || (B.NetName == '*_2' && B.NetName != 'Net*') || (B.NetName == '*_3' && B.NetName != 'Net*'))"))

(rule "isolamento T02 > 30 V"
    (layer outer)
    (constraint clearance (min 0.6mm))
    (condition "A.NetName == 'T02' && (B.NetName == 'T10' || B.NetName == 'T11' || B.NetName == 'T12' || B.NetName == 'T13' || B.NetName == 'T14' || B.NetName == 'T15' || B.NetName == 'T16' || B.NetName == 'T17' || B.NetName == 'T18' || B.NetName == 'T19' || B.NetName == 'T20' || B.NetName == 'T21' || B.NetName == 'T22' || B.NetName == 'T23' || B.NetName == 'T24' || B.NetName == 'T25' || B.NetName == 'T26' || B.NetName == 'T27' || B.NetName == 'T28' || (B.NetName == '*_2' && B.NetName != 'Net*') || (B.NetName == '*_3' && B.NetName != 'Net*'))"))

(rule "isolamento T03 > 30 V"
    (layer outer)
    (constraint clearance (min 0.6mm))
    (condition "A.NetName == 'T03' && (B.NetName == 'T11' || B.NetName == 'T12' || B.NetName == 'T13' || B.NetName == 'T14' || B.NetName == 'T15' || B.NetName == 'T16' || B.NetName == 'T17' || B.NetName == 'T18' || B.NetName == 'T19' || B.NetName == 'T20' || B.NetName == 'T21' || B.NetName == 'T22' || B.NetName == 'T23' || B.NetName == 'T24' || B.NetName == 'T25' || B.NetName == 'T26' || B.NetName == 'T27' || B.NetName == 'T28' || (B.NetName == '*_2' && B.NetName != 'Net*') || (B.NetName == '*_3' && B.NetName != 'Net*'))"))

