(rule "isolamento CSC_0 > 30 V"
    (layer outer)
    (constraint clearance (min 0.6mm))
    (condition "(A.NetName == '*_0' && A.NetName != 'Net*') && ((B.NetName == '*_3' && B.NetName != 'Net*'))"))

# Lado do cabo do transformador: potencial do modulo vizinho (ate 588 V em falha).
# FSAE EV.7.5.7, 300-600 V, sob verniz: 4,0 mm (a slave leva verniz, D46).
(rule "WIRE_IN isolado"
    (constraint clearance (min 4.0mm))
    (constraint creepage (min 4.0mm))
    (condition "A.NetName == 'WIRE_IN_*' && B.NetName != 'WIRE_IN_*' && B.NetName != ''"))

# Corrente de balanceamento (~0,44 A): tomadas e dreno do PMOS (GND das CSCs fica de fora).
# Classe BAL roteia com 0,4 mm; o roteador estreita para 0,25 mm na chegada dos pads (trechos curtos).
(rule "trilhas de balanceamento"
    (constraint track_width (min 0.25mm))
    (condition "(A.NetName == 'T??' || A.NetName == 'NetQ*') && A.NetName != 'T00' && A.NetName != 'T07' && A.NetName != 'T14' && A.NetName != 'T21'"))

# Via-in-pad nos pinos sem saida dos TLE9012 (17/TMP1, 21/PWM0, 18/TMP0 e alguns do lado 37-48):
# o bolso entre os GNDs 15/19/22 e o pad exposto nao comporta 3 vias de 0,5 mm, e por fora nao ha saida.
# Via 0,30/0,15 dentro do pad (pad de 0,29 mm), epoxy filled & capped: a via cabe na largura do pad e a
# folga ate o pino vizinho fica em ~0,20 mm (JLC: via min. 0,15/0,25 mm; pad SMD a pad SMD 0,15 mm).
(rule "via-in-pad TLE9012: tamanho"
    (constraint via_diameter (min 0.3mm))
    (constraint hole_size (min 0.15mm))
    (constraint annular_width (min 0.075mm))
    (condition "A.Type == 'Via' && A.intersectsCourtyard('U?')"))

# Pads de GND no bottom presos ao plano por um raio so (sem espaco para o segundo).
# R182 e C59 tambem tem toco + via ate os planos internos; C81 e C134 ficam com o raio.
(rule "GND com um raio termico"
    (constraint min_resolved_spokes 1)
    (condition "A.Type == 'Pad' && (A.memberOfFootprint('R182') || A.memberOfFootprint('C59') || A.memberOfFootprint('C81') || A.memberOfFootprint('C134'))"))
