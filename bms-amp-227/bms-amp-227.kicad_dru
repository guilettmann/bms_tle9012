    (condition "A.NetName == 'T20' && (B.NetName == 'T28' || (B.NetName == '*_0' && B.NetName != 'Net*'))"))

(rule "isolamento T21 > 30 V"
    (layer outer)
    (constraint clearance (min 0.6mm))
    (condition "A.NetName == 'T21' && ((B.NetName == '*_0' && B.NetName != 'Net*'))"))

(rule "isolamento T22 > 30 V"
    (layer outer)
    (constraint clearance (min 0.6mm))
    (condition "A.NetName == 'T22' && ((B.NetName == '*_0' && B.NetName != 'Net*') || (B.NetName == '*_1' && B.NetName != 'Net*'))"))

(rule "isolamento T23 > 30 V"
    (layer outer)
    (constraint clearance (min 0.6mm))
    (condition "A.NetName == 'T23' && ((B.NetName == '*_0' && B.NetName != 'Net*') || (B.NetName == '*_1' && B.NetName != 'Net*'))"))

